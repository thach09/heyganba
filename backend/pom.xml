<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.heyganba</groupId>
    <artifactId>heyganba-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>heyganba-backend</name>
    <description>Chinese learning platform backend API</description>

    <properties>
        <java.version>21</java.version>
        <build.output.root>${project.basedir}/target</build.output.root>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Compatible security patches newer than the Spring Boot 3.5 BOM. -->
        <tomcat.version>10.1.60</tomcat.version>
        <netty.version>4.1.137.Final</netty.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <postgresql.version>42.7.12</postgresql.version>
        <log4j2.version>2.25.5</log4j2.version>
        <test.excludedGroups>legacy-japanese</test.excludedGroups>
        <legacy.audit.resources>${project.build.directory}/external-legacy-audit-required</legacy.audit.resources>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Redis (tuỳ chọn): chỉ dùng khi `app.srs.cache=redis` (xem RedisSrsDueCache).
            Mặc định `app.srs.cache=memory` nên app KHÔNG cần Redis để chạy; Lettuce chỉ mở kết nối khi có request đầu tiên.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Database & Migration -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Sentry Error Tracking -->
        <dependency>
            <groupId>io.sentry</groupId>
            <artifactId>sentry-spring-boot-starter-jakarta</artifactId>
            <version>7.18.1</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <directory>${build.output.root}</directory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>application.yml</include>
                    <include>application-prod.yml</include>
                    <include>application-dev.yml</include>
                    <include>application-staging.yml</include>
                    <include>db/release-migrations-manifest.json</include>
                    <include>db/migration/beforeEachMigrate.sql</include>
                    <include>db/migration/V1__init_chinese_schema.sql</include>
                    <include>db/migration/V2__seed_chinese_hsk1_data.sql</include>
                    <include>db/migration/V3__disable_public_seed_admin_credential.sql</include>
                    <include>db/migration-release/V4__sample_lesson_greetings.sql</include>
                    <include>db/migration-release/V5__hsk1_thematic_curriculum_expansion.sql</include>
                    <include>db/migration-release/V6__hsk1_standard_course_grammar_and_exams.sql</include>
                    <include>db/migration-release/V7__hsk1_complete_150_vocab_and_hanzi_radicals.sql</include>
                    <include>db/migration-release/V8__hsk2_standard_course_and_approve_all_curriculum.sql</include>
                    <include>db/migration-release/V9__hsk1_to_hsk6_complete_curriculum_and_grammar.sql</include>
                    <include>db/migration-release/V10__learning_insights_and_sentence_order.sql</include>
                    <include>db/migration-release/V11__align_optional_content_nullability.sql</include>
                    <include>db/migration-release/V12__performance_indexes_and_constraints.sql</include>
                    <include>db/migration-release/V13__vocabulary_provenance_review_gate.sql</include>
                    <include>db/migration-release/V14__web_cross_check_evidence_policy.sql</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource><directory>src/test/resources</directory></testResource>
            <testResource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>db/migration-staging/V4__sample_lesson_greetings.sql</include>
                    <include>db/migration-staging/V5__hsk1_thematic_curriculum_expansion.sql</include>
                    <include>db/migration-staging/V6__hsk1_standard_course_grammar_and_exams.sql</include>
                    <include>db/migration-staging/V7__hsk1_complete_150_vocab_and_hanzi_radicals.sql</include>
                    <include>db/migration-staging/V8__hsk2_standard_course_and_approve_all_curriculum.sql</include>
                    <include>db/migration-staging/V9__hsk1_to_hsk6_complete_curriculum_and_grammar.sql</include>
                    <include>db/migration-staging/V10__learning_insights_and_sentence_order.sql</include>
                    <include>db/migration-staging/V11__align_optional_content_nullability.sql</include>
                    <include>db/migration-staging/V12__performance_indexes_and_constraints.sql</include>
                    <include>db/migration-staging/V13__vocabulary_provenance_review_gate.sql</include>
                    <include>db/migration-staging/V14__web_cross_check_evidence_policy.sql</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration><excludedGroups>${test.excludedGroups}</excludedGroups></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>legacy-japanese-audit</id>
            <properties><test.excludedGroups></test.excludedGroups></properties>
            <build>
                <testResources>
                    <testResource><directory>src/test/resources</directory></testResource>
                    <testResource><directory>${legacy.audit.resources}</directory></testResource>
                </testResources>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>legacy-japanese</groups>
                            <systemPropertyVariables>
                                <legacy.dictionary.assisted-release>true</legacy.dictionary.assisted-release>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
