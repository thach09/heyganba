# ===== HeyGanba Backend — biến môi trường mẫu =====
# Copy sang .env khi chạy local, hoặc set trực tiếp trong Render Dashboard / docker-compose.
# KHÔNG commit file .env chứa giá trị thật.

# --- 1. Profile đang chạy: dev | staging | prod ---
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# --- 2. Database (PostgreSQL managed trên staging/production) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heyganba
DB_USER=postgres
DB_PASSWORD=postgres

# --- 3. JWT ---
# BẮT BUỘC set ở staging/production (thiếu là app fail-fast lúc khởi động).
# Tạo secret mới: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- 4. CORS: danh sách domain frontend, phân tách bằng dấu phẩy ---
# dev: http://localhost:5173,http://localhost:3000
# staging/production: https://<vercel-project>.vercel.app,https://<domain-that>
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- 5. Streak (Phase 5) ---
# Một ngày tính streak khi: >= APP_STREAK_MIN_SRS_REVIEWS lượt ôn SRS, HOẶC 1 lượt thi thử, HOẶC >= APP_STREAK_MIN_QUIZ_QUESTIONS câu ngữ pháp.
# Múi giờ "ngày học" = giờ VN ở MỌI môi trường (local/staging/production) — đây là quyết định đã chốt.
APP_STREAK_ZONE=Asia/Ho_Chi_Minh
APP_STREAK_MIN_SRS_REVIEWS=10
APP_STREAK_MIN_QUIZ_QUESTIONS=10

# --- 6. Cache SRS: ĐANG TẮT (Postgres trực tiếp) theo quyết định vì chưa có Redis managed instance ---
# Code cache đã viết sẵn (RedisSrsDueCache) nhưng CHƯA kích hoạt: giữ memory ở mọi môi trường.
# Khi có Redis managed chỉ cần đổi APP_SRS_CACHE=redis + set REDIS_HOST/REDIS_PORT
# (Redis có auth thì set thêm SPRING_DATA_REDIS_PASSWORD).
APP_SRS_CACHE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
