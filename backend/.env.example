JIAYOU_DATABASE_USER=
JIAYOU_DATABASE_PASSWORD=
JIAYOU_JWT_SECRET=
JIAYOU_CORS_ALLOWED_ORIGINS=
JIAYOU_BOOTSTRAP_MODE=validate
JIAYOU_BOOTSTRAP_AUTHORIZATION=
