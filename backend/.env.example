# ===== HeyGanba Backend — biến môi trường mẫu =====
# Copy sang .env khi chạy local, hoặc set trực tiếp trong Render Dashboard / docker-compose.
# KHÔNG commit file .env chứa giá trị thật.

# --- 1. Profile đang chạy: dev | staging | prod ---
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# --- 2. Database (PostgreSQL managed trên staging/production) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heyganba
DB_USER=postgres
DB_PASSWORD=postgres

# --- 3. JWT ---
# BẮT BUỘC set ở staging/production (thiếu là app fail-fast lúc khởi động).
# Tạo secret mới: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- 4. CORS: danh sách domain frontend, phân tách bằng dấu phẩy ---
# dev: http://localhost:5173,http://localhost:3000
# staging/production: https://<vercel-project>.vercel.app,https://<domain-that>
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
