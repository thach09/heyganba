# HeyGanba Chinese backend — environment template
# Copy to a private .env file. Never commit real credentials.
# The safe default profile is prod. Select SPRING_PROFILES_ACTIVE=dev explicitly for local-only use.

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# PostgreSQL application account (CRUD only). For a local single-role database, omit the
# commented migration variables so Flyway falls back to this account.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heyganba
DB_USER=heyganba_app
DB_PASSWORD=
# On staging/production, set these to the separate DDL migration role.
# SPRING_FLYWAY_USER=
# SPRING_FLYWAY_PASSWORD=

# Required outside local development. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# Explicit browser origins. Replace these with the deployed frontend origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Trust only actual immediate proxy peer CIDRs; never use a public catch-all range.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# The Redis cache is optional; memory is the current default.
APP_SRS_CACHE=memory
REDIS_HOST=localhost
REDIS_PORT=6379

APP_STREAK_ZONE=Asia/Ho_Chi_Minh
APP_STREAK_MIN_SRS_REVIEWS=10
APP_STREAK_MIN_QUIZ_QUESTIONS=10
