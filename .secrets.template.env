# ===== HeyGanba — secrets cho agent tự deploy =====
# CÁCH DÙNG: copy file này thành `.local-secrets.env` (cùng thư mục repo) rồi điền giá trị.
# File `.local-secrets.env` đã nằm trong .gitignore nên KHÔNG thể bị commit.
# Sau khi điền, nhắn agent "đã đặt key" — agent sẽ tự chạy: set env Render, trigger deploy,
# tạo Custom Domain, set Vercel env + domain, thêm GitHub Actions secrets (nếu có PAT), rồi verify.

# (1) Render → Account Settings → API Keys → Create API Key  (bắt đầu bằng `rnd_`)
RENDER_API_KEY=

# (2) Render → service → Settings → Deploy Hook (URL dạng https://api.render.com/deploy/srv-xxx?key=yyy)
RENDER_PROD_DEPLOY_HOOK_URL=
RENDER_STAGING_DEPLOY_HOOK_URL=

# (3) Vercel → Account Settings → Tokens (scope = project heyganba) + Project Settings → IDs
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# (4) (tuỳ chọn) GitHub PAT scope `repo` + `workflow` — để agent tự thêm 5 secret + tạo Environment `production`
GITHUB_TOKEN=

# (5) JWT_SECRET cho backend (nếu để trống, agent sẽ sinh giúp và set vào Render)
JWT_SECRET=

# (6) Thông tin tài khoản Admin quản trị (không commit bản thật)
SEED_ADMIN_PASSWORD=
PROD_ADMIN_PASSWORD=
