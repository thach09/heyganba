# ===== HeyGanba Frontend — biến môi trường (Vite) =====
# Copy file này thành .env.local khi cần đổi cấu hình local (đã bị .gitignore).
# Trên Vercel: set tại Project Settings -> Environment Variables (Production/Preview).

# Base URL backend API, bao gồm context-path /api/v1.
# - Dev local: để trống -> Vite proxy tự chuyển /api sang http://localhost:8080
# - Self-host cùng origin: /api/v1; reverse proxy chuyển tiếp đến backend nội bộ.
VITE_API_BASE_URL=/api/v1
# Same-site deployment only. Enable after deploying the backend cookie transport.
VITE_AUTH_COOKIE=false
