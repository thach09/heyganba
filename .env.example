# ==============================================================================
# HeyGanba Chinese Platform — Consolidated Environment Variables Template
# ==============================================================================
# Usage: Copy this file to .env or .local-secrets.env for local development.
# WARNING: NEVER commit actual production secrets or credentials to git.
# ==============================================================================

# --- 1. Spring Boot & Database (Backend) ---
SPRING_PROFILES_ACTIVE=prod
# For explicit local development only, opt into dev.
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heyganba
DB_USER=heyganba_app
DB_PASSWORD=
POSTGRES_PASSWORD=
# Set these for the separate DDL migration role in Compose/production; omit for a local
# single-role setup so Flyway inherits the datasource account.
# SPRING_FLYWAY_USER=
# SPRING_FLYWAY_PASSWORD=

# --- 2. Security & JWT ---
# Required for staging/production (min 32 bytes base64).
# Generate using: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- 3. Frontend Configuration (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Only the immediate, controlled reverse proxy; never 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- 4. Redis Cache & Streak System ---
APP_STREAK_ZONE=Asia/Ho_Chi_Minh
APP_STREAK_MIN_SRS_REVIEWS=10
APP_STREAK_MIN_QUIZ_QUESTIONS=10
APP_SRS_CACHE=memory
REDIS_HOST=localhost
REDIS_PORT=6379

# --- 5. Deployment & Cloud Keys (Render / Vercel / GitHub Actions) ---
RENDER_API_KEY=
RENDER_PROD_DEPLOY_HOOK_URL=
RENDER_STAGING_DEPLOY_HOOK_URL=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
GITHUB_TOKEN=

# --- 6. Initial Seed Admin Credentials ---
SEED_ADMIN_PASSWORD=
PROD_ADMIN_PASSWORD=
